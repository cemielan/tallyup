{
  "name": "tallyup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Split-bill PWA with an open, end-to-end encrypted sharing API.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/copy-ocr.mjs",
    "dev": "vite",
    "dev:api": "npm run build && wrangler dev",
    "prebuild": "node scripts/copy-ocr.mjs",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy --env production",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig web/tsconfig.json --fail-on-warnings",
    "lint": "npm run typecheck",
    "test": "vitest run && vitest run --config vitest.web.config.ts",
    "test:watch": "vitest",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.web.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tallyup-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tallyup-db --remote --env production",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "debt-simplify": "*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "svelte": "^5.57.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ind": "^1.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "~5.0.3",
    "wrangler": "^4.131.0"
  },
  "engines": {
    "node": ">=22"
  }
}
