# Security headers for the static PWA. Cloudflare's asset handler applies
# this file; API responses get theirs from Hono's secureHeaders instead.
#
# CSP notes (docs/05-SECURITY.md §6):
# - 'wasm-unsafe-eval' lets the OCR worker compile Tesseract's WebAssembly.
#   It does not allow eval() of JavaScript.
# - style-src needs 'unsafe-inline' for Svelte's transition styles. Scripts
#   get no such allowance.
# - Fonts and Turnstile (Cloudflare's bot check) are the only third-party
#   origins. The service worker re-fetches fonts, which is why they also
#   appear under connect-src. Turnstile needs script-src and frame-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' blob: data:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self'; frame-src https://challenges.cloudflare.com; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
